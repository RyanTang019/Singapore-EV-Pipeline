FROM python:3.11-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /opt/dagster/app

ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy

# Install dependencies first (cached layer — only rebuilds if pyproject.toml or uv.lock change)
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# Then copy your code and install the project itself
COPY src/ src/
COPY transform/ transform/
RUN uv sync --frozen --no-dev

ENV PATH="/opt/dagster/app/.venv/bin:$PATH"

# Bake transform/target/manifest.json into the image. @dbt_assets reads the manifest at
# defs-load time, so `code-server start -m orchestrate.definitions` (below) crashes with
# DagsterDbtManifestNotFoundError without it. prepare_if_dev() only regenerates it under
# `dg dev`, and the CI build context is a fresh checkout where target/ (gitignored) is absent.
# `dbt parse` renders profiles.yml/sources.yml via env_var() so it needs these vars, but it
# does NOT connect to BigQuery — build-time dummies suffice; real values come from the VM env.
ENV GCP_PROJECT_ID=dummy-project \
    GCP_REGION=asia-southeast1 \
    DEV_SCHEMA_PREFIX=dummy_dev \
    BQ_DATASET_RAW=dummy_raw
RUN dbt parse --project-dir transform --profiles-dir transform

EXPOSE 4000

HEALTHCHECK --timeout=3s --start-period=30s --interval=5s --retries=12 \
    CMD ["dagster", "api", "grpc-health-check", "-p", "4000"]

CMD ["dagster", "code-server", "start", "-h", "0.0.0.0", "-p", "4000", "-m", "orchestrate.definitions"]