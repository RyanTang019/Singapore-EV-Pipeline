[sqlfluff]
# jinja (not dbt) templater: the dbt templater opens a live BigQuery connection
# during linting (to build its relations cache), which requires GCP credentials
# and fails in credential-less CI. The jinja templater renders models via the
# dbt-builtin macro stubs below — no warehouse connection, no env vars needed.
# dbt DAG validation (broken refs etc.) is covered by `dbt parse`/build in the
# pipeline, not by this style lint.
templater = jinja
dialect = bigquery
runaway_limit = 10

[sqlfluff:templater]
unwrap_wrapped_queries = true

[sqlfluff:templater:jinja]
apply_dbt_builtins = True
# Load the project's custom macros (planning_area_of, time_features) so the jinja
# templater can render models that call them — otherwise they lint as undefined.
load_macros_from_path = transform/macros

[sqlfluff:templater:jinja:macros]
dbt_ref = {% macro ref(model_ref) %}{{model_ref}}{% endmacro %}
dbt_source = {% macro source(source_name, table) %}{{source_name}}_{{table}}{% endmacro %}
dbt_config = {% macro config() %}{% for k in kwargs %}{% endfor %}{% endmacro %}
dbt_var = {% macro var(variable, default='') %}item{% endmacro %}
dbt_is_incremental = {% macro is_incremental() %}True{% endmacro %}

[sqlfluff:indentation]
indented_joins = False
template_blocks_indent = True
tab_space_size = 4

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = consistent

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = lower

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

[sqlfluff:rules:aliasing.expression]
allow_scalar = False

[sqlfluff:rules:references.keywords]
unquoted_identifiers_policy = aliases

[sqlfluff:rules:structure.subquery]
forbid_subquery_in = join

[sqlfluff:rules:convention.count_rows]
prefer_count_1 = False

[sqlfluff:rules:convention.select_trailing_comma]
select_clause_trailing_comma = forbid
