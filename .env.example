# GCP
GCP_PROJECT_ID='sg-pipeline-dev'        # your dev GCP project ID
GCP_REGION='asia-southeast1'

# BigQuery
BQ_DATASET_RAW='dev_raw'                     # SHARED landing zone — same for all devs; never set to prod_raw locally
DEV_SCHEMA_PREFIX='dev_<developer>'          # dev_<your_handle> — your private staging/marts

# LTA DataMall API
LTA_API_KEY='your_lta_api_key'

# OneMap
ONEMAP_EMAIL='your_email@example.com'
ONEMAP_EMAIL_PASSWORD='your_password'
